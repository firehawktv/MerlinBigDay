# Set these as environment variables on the server
# (CloudPanel: Node.js site > Environment).
TEACHER_PASSWORD=change-me-please
PORT=3000
# Keep the database outside the git checkout so redeploys never touch it.
DB_PATH=/home/CLOUDPANEL_USER/birds-data/birds.db
# eBird export: one site and date for the whole class.
EVENT_DATE=2026-10-10
SITE_NAME=New Haven County, CT
SITE_LAT=
SITE_LON=
